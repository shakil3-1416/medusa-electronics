# Copy to icecat.env (git-ignored) and fill in. Never commit the filled file.
# Live API lookups use the user name; index/daily feeds use user name + password
# (HTTP Basic auth on data.icecat.biz).
ICECAT_USERNAME=
ICECAT_PASSWORD=
# Set to 1 only if the account holder accepted the Open Content License.
ICECAT_OCL_ACCEPTED=
# Only for paid Full Icecat brands.
ICECAT_APP_KEY=
