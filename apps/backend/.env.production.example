# Production environment for the separately hosted Medusa backend
# (Railway, Render, Fly, a VM, or Medusa Cloud). Vercel cannot run it.
# Never commit real values. Generate secrets with: openssl rand -base64 48

NODE_ENV=production
PORT=9000

# Managed PostgreSQL 15+ (TLS recommended).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/medusa?sslmode=require

# Redis for event bus, workflow engine, caching and locking in production.
# Note: medusa-config.ts does not yet register the Redis modules; see
# sgnova/reports/PRODUCTION_READINESS.md before going live.
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Long random values, different per environment.
JWT_SECRET=replace_with_random_secret
COOKIE_SECRET=replace_with_random_secret

# CORS: the Vercel storefront origin for the store API; the backend origin
# for the admin; both for auth. Comma-separated, no trailing slashes.
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://api.example.com,https://shop.example.com

# Used only by `medusa exec ./src/scripts/enrich-sgnova.ts` to write absolute
# catalog image URLs that point at the storefront's /public/catalog files.
SGNOVA_IMAGE_BASE_URL=https://shop.example.com

# Catalog pipeline only (sgnova/catalog/real/icecat_adapter.py), not the server.
# Set ICECAT_OCL_ACCEPTED=1 only after the account holder accepted the Open
# Content License. ICECAT_APP_KEY is needed only for paid Full Icecat brands.
ICECAT_USERNAME=
ICECAT_OCL_ACCEPTED=
ICECAT_APP_KEY=
