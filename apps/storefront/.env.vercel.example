# Production environment for the Medusa storefront on Vercel.
# Set these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values. Root directory for the Vercel project: apps/storefront

# Public HTTPS URL of the separately hosted Medusa backend (no trailing slash).
# A hosted build fails if this is missing or points at localhost.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com

# Publishable API key (Medusa Admin -> Settings -> Publishable API Keys),
# linked to the Default Sales Channel. Publishable, but still keep it out of Git.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Public origin of this storefront: canonical URLs, sitemap, JSON-LD, and the
# host allowed for catalog images stored as absolute URLs.
NEXT_PUBLIC_BASE_URL=https://shop.example.com

# Bangladesh-only storefront.
NEXT_PUBLIC_DEFAULT_REGION=bd
NEXT_PUBLIC_STORE_COUNTRIES=bd

# Optional: CDN or bucket origin if product images move off /public/catalog.
NEXT_PUBLIC_IMAGE_HOST_URL=

# Optional payment providers; leave empty while only manual test payment exists.
NEXT_PUBLIC_STRIPE_KEY=
